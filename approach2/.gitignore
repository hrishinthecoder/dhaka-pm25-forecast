# Secrets
.env
.cdsapirc

# Assistant session data — kept on disk (user instruction) but NEVER committed
# (transcripts can contain pasted secrets)

# Data — regenerated by the ingest pipeline; never commit
data/raw/
data/interim/
data/processed/
data/reference/
!data/**/.gitkeep

# Model artifacts (keep the frozen pack + gitkeep; ignore regenerated experiment models)
models/*
!models/final/
!models/.gitkeep

# Reports: keep the published PNG figures (referenced by docs + app); ignore other scratch
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
env/
build/
dist/

# OS / editor
.DS_Store
.vscode/
.idea/
